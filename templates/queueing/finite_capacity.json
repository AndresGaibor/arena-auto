{
  "name": "{{modelName}}",
  "description": "Finite capacity queue with balking",
  "timeUnits": "{{timeUnits}}",
  "replications": {{replications}},
  "replicationLength": {{replicationLength}},
  "entities": [
    {
      "id": "customer",
      "name": "{{entityName}}"
    }
  ],
  "resources": [
    {
      "id": "server",
      "name": "{{resourceName}}",
      "capacity": {{resourceCapacity}}
    }
  ],
  "flow": [
    {
      "id": "Arrival",
      "type": "create",
      "entity": "customer",
      "arrival": {
        "distribution": { "type": "EXPO", "params": [{{arrivalMean}}] }
      }
    },
    {
      "id": "QueueCap",
      "type": "decide",
      "branches": [
        { "type": "expression", "expression": "NQ(Server.Queue) < {{maxQueue}}" }
      ],
      "elseLabel": "Balk"
    },
    {
      "id": "Service",
      "type": "process",
      "resource": "server",
      "delay": {
        "distribution": { "type": "EXPO", "params": [{{serviceMean}}] },
        "units": "{{timeUnits}}"
      }
    },
    {
      "id": "Exit",
      "type": "dispose"
    },
    {
      "id": "Balk",
      "type": "dispose"
    }
  ],
  "connections": [
    ["Arrival", "QueueCap"],
    ["QueueCap", "Service"],
    ["Service", "Exit"],
    ["QueueCap", "Balk"]
  ],
  "_params": {
    "modelName": { "default": "FiniteCapacity", "description": "Model name" },
    "entityName": { "default": "Customer", "description": "Entity type name" },
    "resourceName": { "default": "Server", "description": "Resource name" },
    "resourceCapacity": { "default": 1, "description": "Number of servers" },
    "arrivalMean": { "default": 4, "description": "Mean interarrival time" },
    "serviceMean": { "default": 3.5, "description": "Mean service time" },
    "maxQueue": { "default": 5, "description": "Maximum queue capacity before balking" },
    "timeUnits": { "default": "Minutes", "description": "Time unit" },
    "replications": { "default": 5, "description": "Number of replications" },
    "replicationLength": { "default": 480, "description": "Length of each replication" }
  }
}
